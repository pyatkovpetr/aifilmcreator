# Optional OpenAI-compatible JSON endpoint. If omitted, the grounded deterministic generator is used.
AI_DIRECTOR_LLM_URL=
AI_DIRECTOR_LLM_API_KEY=
AI_DIRECTOR_LLM_MODEL=gpt-4o-mini

# Keep persistent project data outside the application release directory in production.
AI_DIRECTOR_DATA_DIR=/var/lib/ai-film-creator
