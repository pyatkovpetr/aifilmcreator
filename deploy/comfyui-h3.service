[Unit]
Description=ComfyUI MiniMax H3 video renderer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/comfyui
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONPATH=/opt/comfyui
Environment=LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/nvidia/cu13/lib:/opt/comfyui/.venv-cu130/lib/python3.10/site-packages/nvidia/nccl/lib
ExecStart=/opt/comfyui/.venv-cu130/bin/python main.py --listen 127.0.0.1 --port 8188 --disable-auto-launch --lowvram --fp16-vae --disable-cuda-malloc --preview-method none
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/comfyui

[Install]
WantedBy=multi-user.target
